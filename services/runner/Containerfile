ARG PYTHON_BASE=python:3.14-slim
FROM ${PYTHON_BASE}
ARG FIXTURE_SHA256
LABEL org.bugout.fixture.sha256=${FIXTURE_SHA256}
RUN python -m pip install --no-cache-dir pytest==9.0.3
COPY services/runner/harness.py /opt/bugout/harness.py
COPY fixtures/checkout/README.md fixtures/checkout/checkout.py fixtures/checkout/pytest.ini /fixture/
COPY fixtures/checkout/tests/test_checkout.py /fixture/tests/test_checkout.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 HOME=/tmp
USER 65532:65532
WORKDIR /fixture
ENTRYPOINT ["python", "/opt/bugout/harness.py"]
