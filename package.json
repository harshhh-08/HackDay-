{
  "name": "bug-out",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Bugs in. Answers out. Local-first evidence-based debugging investigations.",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "db:migrate": "node --env-file=.env db/migrate.ts",
    "api": "node --env-file=.env apps/api/main.ts",
    "orchestrator": "node --env-file=.env services/orchestrator/main.ts",
    "engine": "python3 -m services.worker.server",
    "runner": "python3 -m services.runner.server",
    "cli": "node --env-file=.env apps/cli/main.ts",
    "test": "node --test tests/node/*.test.ts",
    "test:python": "python3 -m unittest discover -s tests/python -v",
    "test:integration": "node --env-file=.env scripts/smoke.mjs",
    "test:acceptance": "node --env-file=.env scripts/test-api.mjs",
    "test:database": "node scripts/test-database.mjs",
    "verify:runner": "python3 -m services.runner.verify",
    "benchmark:triage": "python3 scripts/benchmark_triage.py",
    "check": "node scripts/check.mjs",
    "check:python": "python3 scripts/check_python.py",
    "typecheck": "tsc --noEmit",
    "openapi": "node scripts/openapi.ts",
    "package:source": "python3 scripts/package_source.py"
  },
  "dependencies": {
    "bullmq": "6.4.2",
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
