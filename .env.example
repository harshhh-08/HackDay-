# Run `npm run configure` to generate .env with local-only secrets.
API_HOST=127.0.0.1
API_PORT=8787
BUGOUT_API_URL=http://127.0.0.1:8787
BUGOUT_TOKEN=GENERATE_ME
ENGINE_URL=http://127.0.0.1:8788
ENGINE_TOKEN=GENERATE_ME
RUNNER_URL=http://127.0.0.1:8789
RUNNER_TOKEN=GENERATE_ME
APPROVAL_SIGNING_KEY=GENERATE_ME
POSTGRES_PASSWORD=GENERATE_ME
DATABASE_URL=postgresql://bugout:GENERATE_ME@127.0.0.1:5432/bugout
MODEL_PROVIDER=disabled
# Set after building the runner image. Immutable sha256 image ID or repo@sha256.
RUNNER_IMAGE=
# Explicit local-fixture opt-in, after reviewing docs/security.md and testing Podman.
RUNNER_ENABLED=false
WAIT_SECONDS=86400
TOTAL_SECONDS=172800
RETENTION_DAYS=7
